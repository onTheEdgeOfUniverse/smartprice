{
  "manifest_version": 3,
  "name": "CleanPrice: Shopping Price Rounder",
  "short_name": "CleanPrice",
  "version": "1.6",
  "description": "Automatically rounds deceptive shopping prices (.99, 999) to clean whole numbers on Amazon, Flipkart & Google Shopping.",
  "permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanPrice: Shopping Price Rounder",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}